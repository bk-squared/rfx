+def _random_body(rng, shape):
+    m = np.zeros(shape, dtype=bool)
+    for _ in range(3):
+        lo = [rng.integers(1, s - 2) for s in shape]
+        hi = [rng.integers(l + 1, s - 1) for l, s in zip(lo, shape)]
+        m[lo[0]:hi[0], lo[1]:hi[1], lo[2]:hi[2]] = True
+    return m
